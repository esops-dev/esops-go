#!/bin/bash

# This is a shell completion script auto-generated by https://github.com/urfave/cli for bash.

# Macs have bash3 for which the bash-completion package doesn't include
# _init_completion. This is a minimal version of that function.
__{{APP}}_init_completion() {
  COMPREPLY=()
  _get_comp_words_by_ref "$@" cur prev words cword
}

__{{APP}}_bash_autocomplete() {
  if [[ "${COMP_WORDS[0]}" != "source" ]]; then
    local cur opts base words
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    if declare -F _init_completion >/dev/null 2>&1; then
      _init_completion -n "=:" || return
    else
      __{{APP}}_init_completion -n "=:" || return
    fi
    words=("${words[@]:0:$cword}")
    if [[ "$cur" == "-"* ]]; then
      requestComp="${words[*]} ${cur} --generate-shell-completion"
    else
      requestComp="${words[*]} --generate-shell-completion"
    fi
    # urfave/cli emits one "name:description" per line. Strip the
    # description suffix so compgen sees one candidate per line instead
    # of word-splitting the entire output on whitespace (which would
    # turn `index:Inspect and manage indices` into the candidates
    # `index:Inspect`, `and`, `manage`, `indices`).
    local line raw
    raw=$(eval "${requestComp}" 2>/dev/null)
    opts=()
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      opts+=("${line%%:*}")
    done <<< "$raw"
    COMPREPLY=($(compgen -W "${opts[*]}" -- "${cur}"))
    return 0
  fi
}

complete -o bashdefault -o default -o nospace -F __{{APP}}_bash_autocomplete {{APP}}
